<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="org.wit.recyclingTracker.main.MainApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecyclingTracker">

        <activity
            android:name=".views.map.RecyclingTrackerMapView"
            android:exported="false"
            android:label="@string/title_activity_recycling_tracker_maps"
            android:theme="@style/Theme.RecyclingTracker"/>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/MAPS_API_KEY" />

        <activity
            android:name=".views.editLocation.EditLocationView"
            android:exported="false"
            android:label="@string/title_activity_map" />
        <activity
            android:name=".views.splash.SplashView"
            android:theme="@style/Theme.App.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".views.login.LoginView"
            android:exported="false" />
        <activity
            android:name=".views.recylingtrackerlist.RecyclingTrackerListView"
            android:exported="true">
        </activity>
        <activity
            android:name=".views.recyclingtracker.RecyclingTrackerView"
            android:theme="@style/Theme.RecyclingTracker"
            android:windowSoftInputMode="stateHidden|adjustPan">

            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
    </application>

</manifest>
